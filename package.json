{
  "name": "candle-color-mixer",
  "version": "2.3.1",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node scripts/serve.mjs",
    "start:lan": "node scripts/serve.mjs --host=0.0.0.0",
    "start:pages": "node scripts/serve.mjs --base=/candle-color-mixer/ --port=4174",
    "test": "npm run test:unit",
    "test:unit": "node --test",
    "test:e2e": "playwright test",
    "test:all": "npm run test:unit && npm run test:e2e"
  },
  "dependencies": {
    "bootstrap": "5.3.8"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1"
  },
  "engines": {
    "node": ">=22"
  }
}
